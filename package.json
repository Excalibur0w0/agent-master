{
  "name": "agent-master",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "typecheck": "tsc -p tsconfig.json",
    "sim:up": "pnpm --filter @agent-master/remote-sim run up",
    "sim:down": "pnpm --filter @agent-master/remote-sim run down"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "packageExtensions": {
      "@usebruno/filestore@0.12.0": {
        "dependencies": {
          "nanoid": "3.3.18"
        }
      }
    }
  }
}
